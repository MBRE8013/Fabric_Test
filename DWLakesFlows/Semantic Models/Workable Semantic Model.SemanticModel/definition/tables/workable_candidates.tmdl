	partition workable_candidates = m
		mode: import
		source = ```
				let
				    Source = Sql.Database(
				        "xcw6jyrd7wyupgr6hyhdgeb62y-tkhwq332pddenadirvxir3oqke.datawarehouse.fabric.microsoft.com", 
				        "IntellaTriageLakehouse"
				    ),
				    dbo_workable_candidates = Source{[Schema="dbo",Item="workable_candidates"]}[Data],
				
				// Filter out excluded job titles early in the process
				#"Filtered Job Titles" = Table.SelectRows(dbo_workable_candidates, each 
				    [job_title] <> "Clinical Care Manager" and
				    [job_title] <> "IT Service Desk - 2nd Shift - M-F" and
				    [job_title] <> "Operations Administrative Assistant" and
				    [job_title] <> "Operations Assistant" and
				    [job_title] <> "Remote Clinical Support Specialist PM shift with rotating Sat & Sun"
				),
				
				    #"Added Custom" = Table.AddColumn(#"Filtered Job Titles", "Stage Sort Order", each 
				        if [stage] = "Sourced" then 23
				        else if [stage] = "Applied" then 22
				        else if [stage] = "No Invitation Sent" then 21
				        else if [stage] = "Phone Screen Invitation Sent" then 20
				        else if [stage] = "Candidate Never Scheduled" then 19
				        else if [stage] = "Speed & Ping Not Received/Failed" then 18
				        else if [stage] = "Phone Screen Scheduled" then 17
				        else if [stage] = "No Show Phone Screen" then 16
				        else if [stage] = "No Show, Rescheduled/Cancelled" then 15
				        else if [stage] = "I.No Show, Rescheduled/Cancelled" then 14
				        else if [stage] = "Failed Phone Screen" then 13
				        else if [stage] = "HOLD" then 12
				        else if [stage] = "No Show Interview" then 11
				        else if [stage] = "Interview" then 10
				        else if [stage] = "Clinical Interview" then 9
				        else if [stage] = "Failed Interview" then 8
				        else if [stage] = "Failed Clinical Interview" then 7
				        else if [stage] = "Offer Pending" then 6
				        else if [stage] = "Offer" then 5
				        else if [stage] = "Declined Offer" then 4
				        else if [stage] = "Hired" then 1
				        else if [stage] = "Duplicate Candidate" then 999
				        else if [stage] = "Phone Screen" then 999
				        else if [stage] = "Phone Screen Never Scheduled" then 999
				        else if [stage] = "Phone Screen Schedule Request" then 999
				        else if [stage] = "Reviewed" then 999
				        else 999
				    ),
				
				    #"Changed Type" = Table.TransformColumnTypes(#"Added Custom",{{"Stage Sort Order", Int64.Type}}),
				
				    #"Added Custom1" = Table.AddColumn(#"Changed Type", "stage group", each 
				        if [stage] = "Applied" then "Auto Disqualify"
				        else if [stage] = "Candidate Never Scheduled" then "No Response"
				        else if [stage] = "Clinical Interview" then "Failed Screen"
				        else if [stage] = "Declined Offer" then "Declined"
				        else if [stage] = "Duplicate Candidate" then "Duplicate"
				        else if [stage] = "Failed Clinical Interview" then "Failed Screen"
				        else if [stage] = "Failed Interview" then "Failed Screen"
				        else if [stage] = "Failed Phone Screen" then "Failed Screen"
				        else if [stage] = "Hired" then "Hired"
				        else if [stage] = "HOLD" then "Failed Screen"
				        else if [stage] = "I.No Show, Rescheduled/Cancelled" then "Accepted - No Show"
				        else if [stage] = "Interview" then "Failed Screen"
				        else if [stage] = "No Invitation Sent" then "Rejected"
				        else if [stage] = "No Show Interview" then "Accepted - No Show"
				        else if [stage] = "No Show Phone Screen" then "Accepted - No Show"
				        else if [stage] = "No Show, Rescheduled/Cancelled" then "Accepted - No Show"
				        else if [stage] = "Offer" then "Pending Acceptance"
				        else if [stage] = "Offer Pending" then "Pending Acceptance"
				        else if [stage] = "Phone Screen" then "Accepted - No Show"
				        else if [stage] = "Phone Screen Invitation Sent" then "No Response"
				        else if [stage] = "Phone Screen Never Scheduled" then "No Response"
				        else if [stage] = "Phone Screen Schedule Request" then "No Response"
				        else if [stage] = "Phone Screen Scheduled" then "Accepted - No Show"
				        else if [stage] = "Reviewed" then "Rejected"
				        else if [stage] = "Sourced" then "Rejected"
				        else if [stage] = "Speed & Ping Not Received/Failed" then "Accepted - No Show"
				        else null
				    ),
				
				    #"Added Custom2" = Table.AddColumn(#"Added Custom1", "stage group custom sort", each 
				        if [stage group] = "Hired" then 1
				        else if [stage group] = "Declined" then 2
				        else if [stage group] = "Pending Acceptance" then 3
				        else if [stage group] = "Failed Screen" then 4
				        else if [stage group] = "Accepted - No Show" then 5
				        else if [stage group] = "No Response" then 6
				        else if [stage group] = "Rejected" then 7
				        else if [stage group] = "Auto Disqualify" then 8
				        else null
				    ),
				    
				    // Convert created_at from UTC to Central Time with automatic DST handling
				    #"Add created_at_datetime" = Table.AddColumn(
				        #"Added Custom2",
				        "created_at_datetime",
				        each 
				            let
				                utcDateTime = [created_at],
				                year = Date.Year(utcDateTime),
				                
				                // Calculate 2nd Sunday in March (DST starts at 2 AM)
				                marchFirst = #date(year, 3, 1),
				                marchFirstDayOfWeek = Date.DayOfWeek(marchFirst, Day.Sunday),
				                dstStart = #datetime(year, 3, 8 + (7 - marchFirstDayOfWeek), 2, 0, 0),
				                
				                // Calculate 1st Sunday in November (DST ends at 2 AM)
				                novemberFirst = #date(year, 11, 1),
				                novemberFirstDayOfWeek = Date.DayOfWeek(novemberFirst, Day.Sunday),
				                dstEnd = #datetime(year, 11, 1 + (7 - novemberFirstDayOfWeek), 2, 0, 0),
				                
				                // Determine if we're in DST period
				                isDST = utcDateTime >= dstStart and utcDateTime < dstEnd,
				                
				                // Apply appropriate offset
				                offset = if isDST then -5 else -6
				            in
				                utcDateTime + #duration(0, offset, 0, 0),
				        type datetime
				    ),
				    
				    // Convert created_at to date only
				    #"Convert created_at to Date" = Table.AddColumn(
				        #"Add created_at_datetime",
				        "created_at_date",
				        each Date.From([created_at_datetime]),
				        type date
				    ),
				    
				    // Remove the original created_at and rename created_at_date to created_at
				    #"Remove Original created_at" = Table.RemoveColumns(#"Convert created_at to Date", {"created_at"}),
				    #"Rename to created_at" = Table.RenameColumns(#"Remove Original created_at", {{"created_at_date", "created_at"}}),
				    
				    // Filter out null/empty created_at values before adding quarter
				    #"Filtered Rows Early" = Table.SelectRows(#"Rename to created_at", each [created_at] <> null and [created_at] <> ""),
				    
				    // Add Quarter column based on created_at
				    #"Add Quarter" = Table.AddColumn(
				        #"Filtered Rows Early",
				        "Quarter",
				        each 
				            let
				                theDate = [created_at],
				                year = Date.Year(theDate),
				                month = Date.Month(theDate),
				                quarter = 
				                    if month >= 1 and month <= 3 then "Q1"
				                    else if month >= 4 and month <= 6 then "Q2"
				                    else if month >= 7 and month <= 9 then "Q3"
				                    else "Q4",
				                quarterYear = Text.From(year) & " " & quarter
				            in
				                quarterYear,
				        type text
				    ),
				    
				    // Group by email and Quarter, then select the best record per group
				    #"Grouped Rows" = Table.Group(
				        #"Add Quarter",
				        {"email", "Quarter"},
				        {
				            {"BestRecord", (grp) =>
				                let
				                    // Sort by Stage Sort Order (ascending), then by created_at (descending)
				                    sorted = Table.Sort(grp, {{"Stage Sort Order", Order.Ascending}, {"created_at", Order.Descending}}),
				                    // Take the first row (lowest Stage Sort Order, and if tied, latest created_at)
				                    firstRow = Table.FirstN(sorted, 1)
				                in
				                    firstRow,
				                type table
				            }
				        }
				    ),
				    
				    // Expand the BestRecord column to get all original columns back
				    #"Expanded BestRecord" = Table.ExpandTableColumn(
				        #"Grouped Rows",
				        "BestRecord",
				        List.Difference(
				            Table.ColumnNames(#"Add Quarter"),
				            {"email", "Quarter"}
				        )
				    ),
				
				    // Apply final type conversions
				    #"Changed Type Final" = Table.TransformColumnTypes(
				        #"Expanded BestRecord",
				        {
				            {"created_at", type date},
				            {"created_at_datetime", type datetime},
				            {"stage group custom sort", Int64.Type}, 
				            {"Stage Sort Order", Int64.Type}
				        }
				    )
				
				in
				    #"Changed Type Final"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

