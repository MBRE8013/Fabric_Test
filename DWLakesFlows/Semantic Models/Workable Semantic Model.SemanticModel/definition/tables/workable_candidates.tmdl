table workable_candidates
	lineageTag: e93b7379-6a5f-447a-aa90-6079d2ef6204

	measure 'Flow Count' = COUNTROWS('workable_candidates')
		formatString: 0
		lineageTag: 84607ab7-49f6-4740-bcda-84ce671f411f

	measure 'Funnel Count' = ```
			
			VAR SelectedStage = SELECTEDVALUE('Funnel Stages'[Funnel Stage])
			
			// Base counts from stage group
			VAR TotalApplied = COUNTROWS('workable_candidates')
			VAR RejectedCount = 
			    CALCULATE(COUNTROWS('workable_candidates'), 'workable_candidates'[stage group] = "Rejected")
			VAR AutoDisqualifyCount = 
			    CALCULATE(COUNTROWS('workable_candidates'), 'workable_candidates'[stage group] = "Auto Disqualify")
			VAR NoResponseCount = 
			    CALCULATE(COUNTROWS('workable_candidates'), 'workable_candidates'[stage group] = "No Response")
			VAR AcceptedNoShowCount = 
			    CALCULATE(COUNTROWS('workable_candidates'), 'workable_candidates'[stage group] = "Accepted - No Show")
			VAR FailedScreenCount = 
			    CALCULATE(COUNTROWS('workable_candidates'), 'workable_candidates'[stage group] = "Failed Screen")
			VAR PendingAcceptanceCount = 
			    CALCULATE(COUNTROWS('workable_candidates'), 'workable_candidates'[stage group] = "Pending Acceptance")
			VAR DeclinedCount = 
			    CALCULATE(COUNTROWS('workable_candidates'), 'workable_candidates'[stage group] = "Declined")
			VAR HiredCount = 
			    CALCULATE(COUNTROWS('workable_candidates'), 'workable_candidates'[stage group] = "Hired")
			
			// Calculated stages
			VAR PhoneScreenInviteCount = TotalApplied - RejectedCount - AutoDisqualifyCount
			VAR PSConductedCount = PhoneScreenInviteCount - NoResponseCount - AcceptedNoShowCount
			VAR OfferSentCount = PSConductedCount - FailedScreenCount
			VAR RescindedCount = OfferSentCount - PendingAcceptanceCount - DeclinedCount - HiredCount
			
			RETURN
			    SWITCH(
			        SelectedStage,
			        "Applied", TotalApplied,
			        "Rejected", RejectedCount,
			        "Auto Disqualify", AutoDisqualifyCount,
			        "Phone Screen Invite", PhoneScreenInviteCount,
			        "No Response", NoResponseCount,
			        "Accepted - No Show", AcceptedNoShowCount,
			        "PS Conducted", PSConductedCount,
			        "Failed Screen", FailedScreenCount,
			        "Offer Sent", OfferSentCount,
			        "Rescinded", RescindedCount,
			        "Pending Acceptance", PendingAcceptanceCount,
			        "Declined", DeclinedCount,
			        "Hired", HiredCount,
			        BLANK()
			    )
			```
		formatString: 0
		lineageTag: 902da3f9-507b-4020-9bf5-a51dddaf887d

