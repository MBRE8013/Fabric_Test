			)
		formatString: 0
		lineageTag: 95d9d36f-a84c-41a4-8ed8-248b17183b6d

	measure '%New New is 1' =
			DIVIDE(
			    CALCULATE(
			        COUNTROWS('Data'),
			        'Data'[New New Skilled] = "1"
			    ),
			    COUNTROWS('Data'),
			    0
			)
		formatString: 0
		lineageTag: 80fa36de-55b7-462c-ae39-84a9f29eb535

	measure 'Green New New' = IF([%New New is 1]>=.8,[New New is 1])
		formatString: 0
		lineageTag: 4ea704af-e232-4fba-8cd6-4f1c57195695

	measure 'Yellow New New' = IF(AND([%New New is 1]<0.8,[%New New is 1]>=.7),[New New is 1])
		formatString: 0
		lineageTag: ffadc944-d22a-40d5-81bc-2cb54b6fb327

	measure 'Red New New' = IF([%New New is 1]<.7,[New New is 1])
		formatString: 0
		lineageTag: c981861b-a0c9-4ceb-b7eb-933de4760a2e

	measure '% Abandoned Calls' =
			
			IF(
			    ISBLANK([Abandoned Count]) && ISBLANK([Answer Count]),
			    0,
			    DIVIDE([Abandoned Count] + 0, ([Answer Count] + 0) + ([Abandoned Count] + 0), 0)
			)
		lineageTag: 63cf1c93-e414-473e-91e4-9b485ef58df8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Answer Count' =
			
			CALCULATE(
			    COUNTROWS('Data'),
			    'Data'[Call Result] = "Answered"
			)
		formatString: 0
		lineageTag: 3f466d66-5990-4104-8d00-6de4e843fcb6

	measure 'Abandoned Count' =
			
			CALCULATE(
			    COUNTROWS('Data'),
			    'Data'[Call Result] = "Abandoned",
			    'Data'[Under 60] = "0"
			)
		formatString: 0
		lineageTag: ddf8f436-6a4b-405b-9c3f-8dbffaa7d179

	measure 'Green Abdondon' = IF([% Abandoned Calls]<=.04,[Abandoned Count])
		formatString: 0
		lineageTag: 6ff796b3-64bc-47f3-80f1-590a2bbdf4bd

	measure 'Yellow Abdondon' = IF(AND([% Abandoned Calls]>.04,[% Abandoned Calls]<=0.06),[Abandoned Count])
		formatString: 0
		lineageTag: 7db6f092-0114-40c6-81eb-e8a681774d28

	measure 'Red Abdondon' = IF([% Abandoned Calls]>.06,[Abandoned Count])
		formatString: 0
		lineageTag: d3191cd7-c667-4d12-8c5e-18a0bd94156c

