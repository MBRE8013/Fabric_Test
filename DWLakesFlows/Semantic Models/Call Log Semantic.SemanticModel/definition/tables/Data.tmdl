		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Least Talk' =
			
			VAR TotalSeconds = [Least Talk Time]  // Reference the measure directly
			VAR Minutes = QUOTIENT(TotalSeconds, 60)
			VAR Seconds = MOD(TotalSeconds, 60)
			RETURN
