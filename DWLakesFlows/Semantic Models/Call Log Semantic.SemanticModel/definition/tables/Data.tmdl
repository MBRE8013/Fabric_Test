	measure 'Avg Speed to Answer' = AVERAGEX('Data', Data[Wait Seconds])
		lineageTag: 78087a67-f65f-4895-a06c-8c26080dbb48

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'AVG Speed' =
			
			VAR TotalSeconds = [Avg Speed to Answer]
			VAR Minutes = INT (TotalSeconds / 60)
			VAR Seconds = ROUND(MOD(Totalseconds,60),0)
			RETURN
			FORMAT (Minutes, "0") &":"& FORMAT(Seconds, "00")
		lineageTag: 76a846f2-2d4e-4d05-8f9e-bcf61d5c6232

	measure 'Longest Wait Time' =
			
			VAR TotalSeconds = [Longest Speed to Answer]
			VAR Minutes = INT (TotalSeconds / 60)
			VAR Seconds = ROUND(MOD(Totalseconds,60),0)
			RETURN
			FORMAT (Minutes, "0") &":"& FORMAT(Seconds, "00")
		lineageTag: d4f21a01-57aa-4471-8c07-3df2b8c6844d

	measure 'Longest Speed to Answer' = MAXX('Data', Data[Wait Seconds])
		lineageTag: 301f39b8-642b-4d0e-b1d2-acd36060e035

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Talk Time' = AVERAGEX('Data', Data[Talk Seconds])
		lineageTag: c48f8611-4cdd-47d1-9a0f-9183a9d2e805

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'AVG Talk' =
			
			VAR TotalSeconds = [Avg Talk Time]
			VAR Minutes = INT (TotalSeconds / 60)
			VAR Seconds = ROUND(MOD(Totalseconds,60),0)
			RETURN
			FORMAT (Minutes, "0") &":"& FORMAT(Seconds, "00")
		lineageTag: fd18b651-1378-4e5d-acec-5845f83ceb99

	measure Pct_Under60 = ```
			
			VAR TotalCalls = COUNTROWS(Data)
			VAR CallsUnder60 = CALCULATE(COUNTROWS(Data), 'Data'[Wait Seconds] < 60)
			RETURN
			DIVIDE(CallsUnder60, TotalCalls)
			
			```
		lineageTag: ff497cb0-5651-4299-ae3c-75841f8cb1f8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Donut Value' =
			
			VAR lbl = SELECTEDVALUE ( Slices[Label] )
			RETURN
			SWITCH (
			    TRUE(),
			    lbl = "Filled",     [Pct_Under60],
			    lbl = "Remaining",  1 - [Pct_Under60],
			    BLANK()
			)
		lineageTag: 4be085a3-c505-4289-931b-18f55c55bd0c

	measure 'Donut Color' =
			
			VAR lbl = SELECTEDVALUE ( Slices[Label] )
			RETURN
			IF (
			    lbl = "Remaining",
			    "#E5E5E5",                                 -- light gray
			    SWITCH (
			        TRUE(),
			        [Pct_Under60] >= 0.8, "#107C10",       -- green
			        [Pct_Under60] >= 0.7, "#FFB900",       -- yellow
			        "#E81123"                              -- red
			    )
			)
		lineageTag: 8096893e-0542-4005-87cb-6f8f9f8c87e8

	measure 'Under 60 Seconds' = SUM(talk)
		lineageTag: bff0b47f-5c09-4160-8c38-5f2e50da6a0e

	measure Calls_Under60 = ```
			
			CALCULATE (
			    COUNTROWS ( 'Data' ),
			    'Data'[Wait Seconds] < 60
			)
			
			```
		formatString: 0
		lineageTag: 641dc754-a7e3-4e0c-ae60-98c0da02e47a

	measure Calls_Above60 =
			
			CALCULATE (
			    COUNTROWS ( 'Data' ),
			    'Data'[Wait Seconds] >= 60
			)
		formatString: 0
		lineageTag: e9d0ba6c-75bd-4744-8d57-686754821796

	measure 'Yellow Below 60' = IF(AND([Pct_Under60]<0.8,[Pct_Under60]>=0.6),[Calls_Under60])
		formatString: 0
		lineageTag: 6ffca25b-368f-4ad0-8cf6-52d32fb4e0b7

	measure 'Green Below 60' = IF([Pct_Under60]>=0.8,[Calls_Under60])
		formatString: 0
		lineageTag: 127e1bf1-a5e9-47a6-947f-08c4219d9ffa

	measure 'Red Below 60' = IF([Pct_Under60]<0.6,[Calls_Under60])
		formatString: 0
		lineageTag: a1b52a21-68ec-48cf-836a-8f643d972ba3

	measure 'Row Count' = COUnTROWS(Data)
