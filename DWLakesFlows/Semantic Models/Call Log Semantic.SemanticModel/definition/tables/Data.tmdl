	partition Data = m
		mode: import
		source =
				let
				    // Append all monthly queries
				    Source = Table.Combine({
				        #"12012025",
				        #"11012025",
				        #"10012025",
				        #"09012025",
				        #"06012025",
				        #"03012025"
				    }),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Contact Start Date Time", type datetime}, {"Contact End Date Time", type datetime}}),
				    #"Added Custom" = Table.AddColumn(#"Changed Type", "Team Sort Order", each let
				    t = [Team]
				in
				    // Standard Teams
				    if t = "Team 1" then 1
				    else if t = "Team 2" then 2
				    else if t = "Team 3" then 3
				    else if t = "Team 4" then 4
				    else if t = "Team 5" then 5
				    else if t = "Team 6" then 6
				    else if t = "Team 7" then 7
				    else if t = "Team 8" then 8
				    else if t = "Team 9" then 9
				    else if t = "Team 10" then 10
				    else if t = "Team 11" then 11
				    else if t = "Team 12" then 12
				
				    // NAL Weekend Teams
				    else if t = "NAL Weekend Morning" then 20
				    else if t = "NAL Weekend Day" then 21
				    else if t = "NAL Weekend Evening" then 22
				    else if t = "NAL Weekend Overnight" then 23
				
				    // WED## Teams
				    else if t = "WED1" then 101
				    else if t = "WED2" then 102
				    else if t = "WED3" then 103
				    else if t = "WED4" then 104
				    else if t = "WED5" then 105
				    else if t = "WED6" then 106
				    else if t = "WED7" then 107
				    else if t = "WED8" then 108
				    else if t = "WED9" then 109
				    else if t = "WED10" then 110
				    else if t = "WED11" then 111
				    else if t = "WED12" then 112
				
				    // WEM## Teams
				    else if t = "WEM1" then 121
				    else if t = "WEM2" then 122
				    else if t = "WEM3" then 123
				    else if t = "WEM4" then 124
				    else if t = "WEM5" then 125
				    else if t = "WEM6" then 126
				    else if t = "WEM7" then 127
				    else if t = "WEM8" then 128
				    else if t = "WEM9" then 129
				    else if t = "WEM10" then 130
				    else if t = "WEM11" then 131
				    else if t = "WEM12" then 132
				
				    // WEE## Teams
				    else if t = "WEE1" then 141
				    else if t = "WEE2" then 142
				    else if t = "WEE3" then 143
				    else if t = "WEE4" then 144
				    else if t = "WEE5" then 145
				    else if t = "WEE6" then 146
				    else if t = "WEE7" then 147
				    else if t = "WEE8" then 148
				    else if t = "WEE9" then 149
				    else if t = "WEE10" then 150
				    else if t = "WEE11" then 151
				    else if t = "WEE12" then 152
				
				    else 999),
				    #"Duplicated Column" = Table.DuplicateColumn(#"Added Custom", "Hour", "Hour - Copy"),
				    #"Renamed Columns" = Table.RenameColumns(#"Duplicated Column",{{"Hour - Copy", "Hour Nights"}}),
				    #"Added Custom1" = Table.AddColumn(#"Renamed Columns", "Hour Nights Sort", each let
				    h = [Hour Nights]
				in
				    if h = "11 PM" then 1
				    else if h = "12 AM" then 2
				    else if h = "1 AM" then 3
				    else if h = "2 AM" then 4
				    else if h = "3 AM" then 5
				    else if h = "4 AM" then 6
				    else if h = "5 AM" then 7
				    else if h = "6 AM" then 8
				    else if h = "7 AM" then 9
				    else 999),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Added Custom1",{{"Team Sort Order", Int64.Type}, {"Hour Nights Sort", Int64.Type}})
				in
				    #"Changed Type1"

