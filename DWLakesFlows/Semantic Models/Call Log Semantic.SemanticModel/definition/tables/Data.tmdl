	measure Measure
		lineageTag: c20539cc-3b67-445d-8194-dbe96d63ebbc

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Longest Talk' =
			
			VAR TotalSeconds = [Longest Talk Time]  // Reference the measure directly
			VAR Minutes = QUOTIENT(TotalSeconds, 60)
			VAR Seconds = MOD(TotalSeconds, 60)
			RETURN
			    IF(
			        NOT ISBLANK(TotalSeconds),
			        FORMAT(Minutes, "0") & ":" & FORMAT(Seconds, "00"),
			        BLANK()
			    )
		lineageTag: 94b0d8a0-44a5-4ba5-bb59-d87e9cde12b5

	measure 'Least Talk Time' = ```
			
			MINX('Data', 'Data'[Talk Seconds])
			
