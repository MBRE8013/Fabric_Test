	measure 'New New is 3' =
			
			CALCULATE(
			    COUNTROWS('Data'),
			    'Data'[New New Skilled] = "3"
			)
		formatString: 0
		lineageTag: 370a43ea-d767-4f37-a4bc-c2ee7893319a

	measure 'New New is 1' =
			
			CALCULATE(
			    COUNTROWS('Data'),
