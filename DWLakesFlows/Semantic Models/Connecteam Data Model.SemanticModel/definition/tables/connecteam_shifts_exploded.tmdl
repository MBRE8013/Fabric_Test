table connecteam_shifts_exploded
	lineageTag: 40f55f0b-c2f3-4e14-8a2e-5670db18106d

	measure 'Avg Days Shift Last Updated to Start' =
			
			AVERAGEX(
			    connecteam_shifts_exploded,
			    DATEDIFF(
			        connecteam_shifts_exploded[updated_datetime],
			        connecteam_shifts_exploded[shift_start_datetime],
			        DAY
			    )
			)
		formatString: 0
		lineageTag: f48ac09e-bfab-408c-93df-7ef8be701f60

	measure 'Shift Date Range Short' =
			
			VAR MinDate = MIN(connecteam_shifts_exploded[shift_date])
			VAR MaxDate = MAX(connecteam_shifts_exploded[shift_date])
			RETURN
			IF(
			    MinDate = MaxDate,
			    FORMAT(MinDate, "M/D/YY"),
			    FORMAT(MinDate, "M/D/YY") & " - " & FORMAT(MaxDate, "M/D/YY")
			)
		lineageTag: 7228aaff-e70a-488d-8660-0f4ee47e349f

