	column 'Display Color' =
			
			VAR ShiftColor = connecteam_shifts_exploded[color]
			VAR JobColor = RELATED(dim_connecteam_jobs[job_color])
			RETURN
			IF(
			    NOT(ISBLANK(ShiftColor)) && ShiftColor <> "",
			    ShiftColor,
			    JobColor
			)
		lineageTag: 847c7f2f-a434-40f4-a658-7951bb83052a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Shift Updated to Shift Start Bucket' =
			
			VAR Days = connecteam_shifts_exploded[Days Shift Last Updated to Start]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Days), "Unknown",
			    Days < 1, "Less than 1 day",
			    Days < 3, "1-2 days",
			    Days < 5, "3-4 days",
			    Days < 8, "5-7 days",
			    Days < 15, "8-14 days",
			    Days < 22, "15-21 days",
			    Days >= 22, "Greater than 21 days",
			    "Unknown"
			)
		lineageTag: c40a5721-c3c2-4ef5-9716-e53d8f84a0a0
		summarizeBy: none
		sortByColumn: 'Shift Updated to Shift Start Bucket Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Shift Updated to Shift Start Bucket Sort' =
			
			VAR Days = connecteam_shifts_exploded[Days Shift Last Updated to Start]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Days), 99,
			    Days < 1, 1,
			    Days < 3, 2,
			    Days < 5, 3,
			    Days < 8, 4,
			    Days < 15, 5,
			    Days < 22, 6,
			    Days >= 22, 7,
			    99
			)
		formatString: 0
		lineageTag: 177930ce-072b-4af7-9557-a921b999b943
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Days Shift Last Updated to Start' =
			
			DIVIDE(
			    DATEDIFF(
			        connecteam_shifts_exploded[updated_datetime],
			        connecteam_shifts_exploded[shift_start_datetime],
			        HOUR
			    ),
			    24
			)
		formatString: 0
		lineageTag: a0152823-60c3-4c04-af6c-5e1e378f2118
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation __PBI_SemanticLinks = [{"LinkTarget":{"TableName":"connecteam_shifts_exploded","TableItemName":"Days Shift Last Updated to Start (bins)","ObjectType":4},"LinkType":"UsedInGroup"}]

	column 'Open Shift Status' =
			
			IF(
			    OR(
			        ISBLANK(connecteam_shifts_exploded[open_spots]),
			        connecteam_shifts_exploded[open_spots] = 0
			    ),
			    "Not Open",
			    "Open"
			)
		lineageTag: c27daf49-5385-400e-81f5-d4118d271727
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Days Shift Last Updated to Start (bins)' =
			IF(
				ISBLANK('connecteam_shifts_exploded'[Days Shift Last Updated to Start]),
				BLANK(),
				IF(
					'connecteam_shifts_exploded'[Days Shift Last Updated to Start] >= 0,
					ROUNDDOWN('connecteam_shifts_exploded'[Days Shift Last Updated to Start], 0),
					ROUNDUP('connecteam_shifts_exploded'[Days Shift Last Updated to Start], 0)
				)
			)
		formatString: 0
		lineageTag: 897ca72f-35ce-4628-8a24-20c4964b7e45
		summarizeBy: none

