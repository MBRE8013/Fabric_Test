	column 'Hour Nights Sort'
		dataType: int64
		formatString: 0
		lineageTag: ee1792bf-b122-4f68-8bf4-f24791f64b49
		summarizeBy: sum
		sourceColumn: Hour Nights Sort

		annotation SummarizationSetBy = Automatic

	column PeriodFlag =
			
			VAR CurrentDate = Data[Reporting Date]
			VAR TodayDate = TODAY()
			VAR ThisWeekStart = TodayDate - WEEKDAY(TodayDate, 2) + 1
			VAR ThisWeekEnd = ThisWeekStart + 6
			VAR LastFriday = TodayDate - WEEKDAY(TodayDate, 2) - 2
			VAR LastSunday = LastFriday + 2
			VAR LastWeekStart = ThisWeekStart - 7
			VAR LastWeekEnd = ThisWeekStart - 1
			
			RETURN
			    SWITCH(
			        TRUE(),
			        CurrentDate >= ThisWeekStart && CurrentDate <= ThisWeekEnd, "This Week",
			        CurrentDate >= LastFriday && CurrentDate <= LastSunday, "Last Fri-Sun",
			        CurrentDate >= LastWeekStart && CurrentDate <= LastWeekEnd, "Last Week",
			        CurrentDate >= DATE(YEAR(TodayDate), MONTH(TodayDate), 1) && CurrentDate <= EOMONTH(TodayDate, 0), "This Month",
			        CurrentDate >= DATE(YEAR(EOMONTH(TodayDate, -1)), MONTH(EOMONTH(TodayDate, -1)), 1) && CurrentDate <= EOMONTH(TodayDate, -1), "Last Month",
			        CurrentDate >= DATE(YEAR(TodayDate), (QUARTER(TodayDate) - 1) * 3 + 1, 1) && CurrentDate <= EOMONTH(DATE(YEAR(TodayDate), (QUARTER(TodayDate) - 1) * 3 + 1, 1), 2), "This Quarter",
			        CurrentDate >= DATE(YEAR(EOMONTH(TodayDate, -3)), MONTH(EOMONTH(TodayDate, -3)) - 2, 1) && CurrentDate <= EOMONTH(TodayDate, -3), "Last Quarter",
			        CurrentDate >= DATE(YEAR(TodayDate), 1, 1) && CurrentDate <= DATE(YEAR(TodayDate), 12, 31), "This Year",
			        CurrentDate >= DATE(YEAR(TodayDate) - 1, 1, 1) && CurrentDate <= DATE(YEAR(TodayDate) - 1, 12, 31), "Last Year",
			        BLANK()
			    )
		lineageTag: 0cf6b377-8120-4d1f-98ba-dca3d0ae97ef
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Day - Hour' = 'Data'[Day of Week] & " - " & FORMAT('Data'[Hour], "0")
		lineageTag: cc240a0f-4e03-4887-bbd4-cf32d73aa359
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Time of Day Sort' =
			
			VAR dt = 'Data'[Contact Start Date Time]
			VAR h = HOUR(dt)
			VAR m = MINUTE(dt)
			VAR RoundedMin = FLOOR(m, 15)
			VAR SlotInDay = h * 4 + RoundedMin / 15
			VAR AdjustedSlot = MOD(SlotInDay - 20, 96) + 1
			RETURN
			    AdjustedSlot
		lineageTag: 271f930d-4e52-4eab-bc10-a6beb5efb21d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

