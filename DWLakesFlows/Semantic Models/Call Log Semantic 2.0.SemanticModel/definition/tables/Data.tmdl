	measure 'Longest Speed to Answer Minutes' = MAXX('Data', Data[Wait Seconds])/60
		lineageTag: 006208c6-f3b7-4c92-9ff5-8755f4763f6b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Longest Talk Time' =
			
			MAXX('Data', 'Data'[Talk Seconds])
		lineageTag: 61dafe29-3cb9-41ae-9db3-57b3aefea7b5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Longest Talk' =
			
			VAR TotalSeconds = [Longest Talk Time]  // Reference the measure directly
			VAR Minutes = QUOTIENT(TotalSeconds, 60)
			VAR Seconds = MOD(TotalSeconds, 60)
			RETURN
			    IF(
			        NOT ISBLANK(TotalSeconds),
			        FORMAT(Minutes, "0") & ":" & FORMAT(Seconds, "00"),
			        BLANK()
			    )
		lineageTag: 26502c3a-fb30-4d9f-9921-3e1ca7236c54

