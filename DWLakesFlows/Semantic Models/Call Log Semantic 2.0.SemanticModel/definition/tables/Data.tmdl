	column 'Time of Day' =
			
			VAR dt = 'Data'[Contact Start Date Time]
			VAR h = HOUR(dt)
			VAR m = MINUTE(dt)
			VAR RoundedMin = FLOOR(m, 15)
			VAR h12 = IF(MOD(h, 12) = 0, 12, MOD(h, 12))
			VAR ampm = IF(h < 12, "a", "p")
			VAR minText = IF(RoundedMin = 0, ":00", ":" & FORMAT(RoundedMin, "00"))
			RETURN
			    h12 & minText & ampm
		lineageTag: 540d09d2-ae31-4fea-b487-b0146a2fe1cb
		summarizeBy: none
		sortByColumn: 'Time of Day Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

