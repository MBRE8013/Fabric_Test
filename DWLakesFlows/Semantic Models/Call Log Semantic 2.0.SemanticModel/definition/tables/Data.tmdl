	column contact_date
		dataType: dateTime
		formatString: Long Date
		lineageTag: 7f20cf0a-bd86-468f-a5bd-37ebce31bf1a
		summarizeBy: none
		sourceColumn: contact_date

		variation Variation
			isDefault
			relationship: 42dc3fd4-583b-4504-9e36-1cc44e3946b3
			defaultHierarchy: LocalDateTable_e6affc95-4d90-4e53-97fa-e8c4e4503070.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Wait Time Formatted' =
			
			VAR TotalSeconds = ROUND('Data'[Wait Seconds], 0)
			VAR Minutes = INT(TotalSeconds / 60)
			VAR Seconds = TotalSeconds - (Minutes * 60)
			RETURN
			    Minutes & "m" & Seconds & "s"
		lineageTag: fe88431e-509a-4538-a906-84cddfc08cff
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	hierarchy 'Hour Hierarchy'
		lineageTag: 29292e15-38ec-474a-82ce-fcb7c44867bb

		level Hour
			lineageTag: fe3387b4-2fe8-4ea9-b90a-06560aac8324
			column: Hour

		level 'Time of Day'
			lineageTag: 86e87407-1e3f-4f4e-8e9b-b18a3d14ba11
			column: 'Time of Day'

	partition Data = m
		mode: import
		source = ```
				let
				    // ========================================================================
				    // STEP 1: CONNECT TO FABRIC LAKEHOUSE TABLE
				    // ========================================================================
				    Source = Sql.Databases("xcw6jyrd7wyupgr6hyhdgeb62y-tkhwq332pddenadirvxir3oqke.datawarehouse.fabric.microsoft.com"),
				    IntellaTriageLakehouse = Source{[Name="IntellaTriageLakehouse"]}[Data],
				    dbo_fact_nicecxone_completed_contacts = IntellaTriageLakehouse{[Schema="dbo",Item="fact_nicecxone_completed_contacts"]}[Data],
				    
				    // ========================================================================
				    // STEP 2: INITIAL TYPE CONVERSIONS ON SOURCE DATA
				    // ========================================================================
				    TypedSource = Table.TransformColumnTypes(dbo_fact_nicecxone_completed_contacts, {
				        {"contact_id", Int64.Type},
				        {"master_contact_id", Int64.Type},
				        {"contact_start_date", type datetime},
				        {"first_name", type text},
				        {"last_name", type text},
				        {"media_type_name", type text},
				        {"skill_name", type text},
				        {"from_address", type text},
				        {"to_address", type text},
				        {"pre_queue_seconds", type number},
				        {"in_queue_seconds", type number},
				        {"agent_seconds", type number},
				        {"acw_seconds", type number},
				        {"post_queue_seconds", type number},
				        {"abandon_seconds", type number},
				        {"total_duration_seconds", type number},
				        {"abandoned", type logical}
				    }),
				    
				    // ========================================================================
				    // STEP 3: CREATE HELPER FUNCTION FOR SECONDS TO HH:MM:SS CONVERSION
				    // ========================================================================
				SecondsToTime = (seconds as number) as text =>
				    let
				        totalSeconds = Number.Round(seconds, 0),
				        hours = Number.RoundDown(totalSeconds / 3600),
				        remainingAfterHours = totalSeconds - (hours * 3600),
				        minutes = Number.RoundDown(remainingAfterHours / 60),
				        secs = remainingAfterHours - (minutes * 60),
				        result = 
				            Text.PadStart(Text.From(Int64.From(hours)), 2, "0") & ":" &
				            Text.PadStart(Text.From(Int64.From(minutes)), 2, "0") & ":" &
				            Text.PadStart(Text.From(Int64.From(secs)), 2, "0")
				    in
				        result,
				    
				    // ========================================================================
				    // STEP 4: TRANSFORM TO MATCH SAMPLE SCHEMA
				    // ========================================================================
				    
				    // Add Pasted Date
				    AddedPastedDate = Table.AddColumn(TypedSource, "Pasted Date", 
				        each Text.From(Date.Year([contact_start_date])) & "/" & 
				             Text.PadStart(Text.From(Date.Month([contact_start_date])), 2, "0") & "/" & 
				             Text.PadStart(Text.From(Date.Day([contact_start_date])), 2, "0"), 
				        type text),
				    
				    // Add Contact Agent Name
				    AddedContactAgentName = Table.AddColumn(AddedPastedDate, "Contact Agent Name",
				        each if [last_name] <> null and [first_name] <> null 
				             then [last_name] & ", " & [first_name]
				             else null,
				        type text),
				    
				    // Add Contact Start Date Time (formatted)
				    AddedContactStartDateTime = Table.AddColumn(AddedContactAgentName, "Contact Start Date Time",
				        each Text.From(Date.Year([contact_start_date])) & "/" & 
				             Text.PadStart(Text.From(Date.Month([contact_start_date])), 2, "0") & "/" & 
				             Text.PadStart(Text.From(Date.Day([contact_start_date])), 2, "0") & " " &
				             Text.PadStart(Text.From(Time.Hour([contact_start_date])), 2, "0") & ":" &
				             Text.PadStart(Text.From(Time.Minute([contact_start_date])), 2, "0") & ":" &
				             Text.PadStart(Text.From(Time.Second([contact_start_date])), 2, "0"),
				        type text),
				    
				    // Add Contact End Date Time (calculated and formatted)
				    AddedContactEndDateTime = Table.AddColumn(AddedContactStartDateTime, "Contact End Date Time",
				        each 
				            let
				                endDateTime = [contact_start_date] + #duration(0, 0, 0, [total_duration_seconds])
				            in
				                Text.From(Date.Year(endDateTime)) & "/" & 
				                Text.PadStart(Text.From(Date.Month(endDateTime)), 2, "0") & "/" & 
				                Text.PadStart(Text.From(Date.Day(endDateTime)), 2, "0") & " " &
				                Text.PadStart(Text.From(Time.Hour(endDateTime)), 2, "0") & ":" &
				                Text.PadStart(Text.From(Time.Minute(endDateTime)), 2, "0") & ":" &
				                Text.PadStart(Text.From(Time.Second(endDateTime)), 2, "0"),
				        type text),
				    
				    // Add Prequeued
				    AddedPrequeued = Table.AddColumn(AddedContactEndDateTime, "Prequeued",
				        each if [pre_queue_seconds] > 0 then 1 else null,
				        type number),
				    
				    // Add Prequeue Time
				    AddedPrequeueTime = Table.AddColumn(AddedPrequeued, "Prequeue Time",
				        each if [pre_queue_seconds] > 0 then SecondsToTime([pre_queue_seconds]) else null,
				        type text),
				    
				    // Add Prequeue Abandons (always null - not in source)
				    AddedPrequeueAbandons = Table.AddColumn(AddedPrequeueTime, "Prequeue Abandons", 
				        each null, 
				        type number),
				    
				    // Add Inqueue Time
				    AddedInqueueTime = Table.AddColumn(AddedPrequeueAbandons, "Inqueue Time",
				        each if [in_queue_seconds] > 0 then SecondsToTime([in_queue_seconds]) else null,
				        type text),
				    
				    // Add Talk Time Pasted
				    AddedTalkTimePasted = Table.AddColumn(AddedInqueueTime, "Talk Time Pasted",
				        each if [agent_seconds] > 0 then SecondsToTime([agent_seconds]) else null,
				        type text),
				    
				    // Add ACW Time Pasted
				    AddedACWTimePasted = Table.AddColumn(AddedTalkTimePasted, "ACW Time Pasted",
				        each if [acw_seconds] > 0 then SecondsToTime([acw_seconds]) else null,
				        type text),
				    
				    // Add Postqueue Time (null to match sample)
				    AddedPostqueueTime = Table.AddColumn(AddedACWTimePasted, "Postqueue Time", 
				        each null, 
				        type number),
				    
				    // Add Abandon Time (null to match sample)
				    AddedAbandonTime = Table.AddColumn(AddedPostqueueTime, "Abandon Time", 
				        each null, 
				        type number),
				    
				    // Add Abandons (null to match sample)
				    AddedAbandons = Table.AddColumn(AddedAbandonTime, "Abandons", 
				        each null, 
				        type number),
				    
				    // Add Contact Duration Pasted
				    AddedContactDurationPasted = Table.AddColumn(AddedAbandons, "Contact Duration Pasted",
				        each if [total_duration_seconds] > 0 then SecondsToTime([total_duration_seconds]) else null,
				        type text),
				    
				    // Add Speed Of Answer Pasted
				    AddedSpeedOfAnswerPasted = Table.AddColumn(AddedContactDurationPasted, "Speed Of Answer Pasted",
				        each if [in_queue_seconds] > 0 then SecondsToTime([in_queue_seconds]) else null,
				        type text),
				    
				    // Rename columns to match target schema
				    RenamedToSchema = Table.RenameColumns(AddedSpeedOfAnswerPasted, {
				        {"media_type_name", "Media Type Name"},
				        {"from_address", "ANI/From"},
				        {"contact_id", "Contact ID"},
				        {"to_address", "DNIS/To"},
				        {"master_contact_id", "Master Contact ID"},
				        {"skill_name", "Contact Skill Name"}
				    }),
				    
				    // ========================================================================
				    // STEP 4.5: REMOVE ONLY THE REDUNDANT COLUMNS (Keep all others!)
				    // ========================================================================
				    RemovedRedundantColumns = Table.RemoveColumns(RenamedToSchema, {
				        "contact_start_date",      // Replaced by "Contact Start Date Time"
				        "first_name",              // Replaced by "Contact Agent Name"
				        "last_name",               // Replaced by "Contact Agent Name"
				        "pre_queue_seconds",       // Replaced by "Prequeue Time"
				        "in_queue_seconds",        // Replaced by "Inqueue Time"
				        "agent_seconds",           // Replaced by "Talk Time Pasted"
				        "acw_seconds",             // Replaced by "ACW Time Pasted"
				        "total_duration_seconds"   // Replaced by "Contact Duration Pasted"
				        // KEEPING: post_queue_seconds, abandon_seconds, abandoned (not redundant)
				        // KEEPING: All other 50+ columns from source
				    }),
				    
				    // ========================================================================
				    // STEP 5: CONVERT DATETIME TEXT COLUMNS BACK TO DATETIME FOR CALCULATIONS
				    // ========================================================================
				    ConvertedDateTimes = Table.TransformColumnTypes(RemovedRedundantColumns, {
				        {"Contact Start Date Time", type datetime}, 
				        {"Contact End Date Time", type datetime}
				    }),
				    
				    // ========================================================================
				    // STEP 6: YOUR EXISTING CALCULATED COLUMNS (STARTING FROM YOUR CODE)
				    // ========================================================================
				    
				    // Buffer lookup tables for performance
				    BufferedCustomer = Table.Buffer(Table.Distinct(Customer, {"Reference"})),
				    BufferedNurse = Table.Buffer(Table.Distinct(#"Nurse Reference", {"Log in Reference", "Client"})),
				    BufferedTeam = Table.Buffer(Table.Distinct(Team, {"Day of Week", "Hour", "Customer Name"})),
				    
				    // Add Date
				    #"Added Date" = Table.AddColumn(ConvertedDateTimes, "Date", 
				        each Date.From([Contact Start Date Time]), 
				        type date),
				    
				    // Add Day of Week
				    #"Added Day of Week" = Table.AddColumn(#"Added Date", "Day of Week", 
				        each try Date.ToText(Date.From([Pasted Date]), "ddd") otherwise null,
				        type text),
				    
				    // Add Time
				    #"Added Time" = Table.AddColumn(#"Added Day of Week", "Time", 
				        each Time.From([Contact Start Date Time]), 
				        type time),
				    
				    // Add Hour1
				    #"Added Hour1" = Table.AddColumn(#"Added Time", "Hour1", 
				        each Time.Hour([Contact Start Date Time]), 
				        Int64.Type),
				    
				    // Add Hour
				    #"Added Hour" = Table.AddColumn(#"Added Hour1", "Hour", 
				        each 
				            let h = [Hour1]
				            in if h = 0 then "12 AM"
				               else if h = 12 then "12 PM"
				               else if h < 12 then Text.From(h) & " AM"
				               else Text.From(h - 12) & " PM",
				        type text),
				    
				    // Add Minute
				    #"Added Minute" = Table.AddColumn(#"Added Hour", "Minute", 
				        each Time.Minute([Contact Start Date Time]), 
				        Int64.Type),
				    
				    // Add Reporting Date
				    #"Added Reporting Date" = Table.AddColumn(#"Added Minute", "Reporting Date", 
				        each if [Hour1] < 5 then Date.AddDays([Date], -1) else [Date],
				        type date),
				    
				    // Add Month
				    #"Added Month" = Table.AddColumn(#"Added Reporting Date", "Month", 
				        each Date.Month([Reporting Date]), 
				        Int64.Type),
				    
				    // Rename pasted columns
				    #"Renamed Pasted Columns" = Table.RenameColumns(#"Added Month", {
				        {"Talk Time Pasted", "Talk Time"}, 
				        {"ACW Time Pasted", "ACW Time"}, 
				        {"Contact Duration Pasted", "Contact Duration"}
				    }),
				    
				// Add Call Result
				#"Added Call Result" = Table.AddColumn(#"Renamed Pasted Columns", "Call Result", 
				    each 
				        let
				            skill = try [Contact Skill Name] otherwise "",
				            abandonedFlag = try [abandoned] otherwise false,
				            abandonSeconds = try [abandon_seconds] otherwise 0,
				            talkTime = try [Talk Time] otherwise null,
				            hasAbandoned = (abandonedFlag = true) or (abandonSeconds > 0),
				            hasTalkTime = (talkTime <> null) and (talkTime <> "")
				        in
				            if skill = "Manual Outbound" then "Outbound"
				            else if hasAbandoned then "Abandoned"
				            else if hasTalkTime then "Answered"
				            else "Abandoned",  // No talk time = Abandoned
				    type text),
				    
				// Add Speed of Answer
				#"Added Speed of Answer" = Table.AddColumn(#"Added Call Result", "Speed of Answer", 
				    each 
				        let
				            callResult = try [Call Result] otherwise null,
				            speedPasted = try [Speed Of Answer Pasted] otherwise null,
				            inqueuePasted = try [Inqueue Time] otherwise null,
				            contactDuration = try [Contact Duration] otherwise null,
				            
				            durationValue = 
				                if callResult = "Answered" and speedPasted <> null then 
				                    try Duration.From(speedPasted) otherwise null
				                else if callResult = "Abandoned" and contactDuration <> null then 
				                    try Duration.From(contactDuration) otherwise null
				                else if callResult = "Abandoned" and inqueuePasted <> null then 
				                    try Duration.From(inqueuePasted) otherwise null
				                else if callResult = "Outbound" and contactDuration <> null then 
				                    try Duration.From(contactDuration) otherwise null
				                else null
				        in
				            if durationValue = null then null
				            else #datetime(1899, 12, 31, 0, 0, 0) + durationValue),
				    
				    // Add Under 60
				    #"Added Under 60" = Table.AddColumn(#"Added Speed of Answer", "Under 60", 
				        each 
				            let
				                speed = try [Speed of Answer] otherwise null,
				                baseDateTime = #datetime(1899, 12, 31, 0, 0, 0),
				                oneMinuteDateTime = #datetime(1899, 12, 31, 0, 1, 0)
				            in
				                if speed = null then null
				                else if speed < oneMinuteDateTime then 1
				                else 0),
				    
				    // Merge Customer
				    #"Merged Customer" = Table.NestedJoin(#"Added Under 60", {"Contact Skill Name"}, BufferedCustomer, {"Reference"}, "Customer", JoinKind.LeftOuter),
				    #"Expanded Customer" = Table.ExpandTableColumn(#"Merged Customer", "Customer", {"Customer", "Program", "Service Line", "Skilled"}, {"Customer", "Program", "Service Line", "Skilled"}),
				    
				    // Merge Nurse
				    #"Merged Nurse" = Table.NestedJoin(#"Expanded Customer", {"Contact Agent Name", "Customer"}, BufferedNurse, {"Log in Reference", "Client"}, "Nurse Reference", JoinKind.LeftOuter),
				    #"Expanded Nurse" = Table.ExpandTableColumn(#"Merged Nurse", "Nurse Reference", {"Skill Reference"}, {"New Skilled"}),
				    
				    // Add New New Skilled
				    #"Added New New Skilled" = Table.AddColumn(#"Expanded Nurse", "New New Skilled", 
				        each 
				            try (
				                if [Skilled] = false then 1
				                else if [Skilled] = "ELSE" then 2
				                else if [Skilled] = true and [New Skilled] = 1 then 1
				                else 3
				            ) otherwise 3,
				        Int64.Type),
				    
				    // Merge Team
				    #"Merged Team" = Table.NestedJoin(#"Added New New Skilled", {"Day of Week", "Hour1", "Customer"}, Team, {"Day of Week", "Hour", "Customer Name"}, "Team", JoinKind.LeftOuter),
				    #"Expanded Team" = Table.ExpandTableColumn(#"Merged Team", "Team", {"Team"}, {"Team"}),
				    
				    // Add Team Sort Order
				    #"Added Team Sort" = Table.AddColumn(#"Expanded Team", "Team Sort Order", 
				        each 
				            let t = [Team]
				            in
				                // Standard Teams
				                if t = "Team 1" then 1
				                else if t = "Team 2" then 2
				                else if t = "Team 3" then 3
				                else if t = "Team 4" then 4
				                else if t = "Team 5" then 5
				                else if t = "Team 6" then 6
				                else if t = "Team 7" then 7
				                else if t = "Team 8" then 8
				                else if t = "Team 9" then 9
				                else if t = "Team 10" then 10
				                else if t = "Team 11" then 11
				                else if t = "Team 12" then 12
				                // NAL Weekend Teams
				                else if t = "NAL Weekend Morning" then 20
				                else if t = "NAL Weekend Day" then 21
				                else if t = "NAL Weekend Evening" then 22
				                else if t = "NAL Weekend Overnight" then 23
				                // WED## Teams
				                else if t = "WED1" then 101
				                else if t = "WED2" then 102
				                else if t = "WED3" then 103
				                else if t = "WED4" then 104
				                else if t = "WED5" then 105
				                else if t = "WED6" then 106
				                else if t = "WED7" then 107
				                else if t = "WED8" then 108
				                else if t = "WED9" then 109
				                else if t = "WED10" then 110
				                else if t = "WED11" then 111
				                else if t = "WED12" then 112
				                // WEM## Teams
				                else if t = "WEM1" then 121
				                else if t = "WEM2" then 122
				                else if t = "WEM3" then 123
				                else if t = "WEM4" then 124
				                else if t = "WEM5" then 125
				                else if t = "WEM6" then 126
				                else if t = "WEM7" then 127
				                else if t = "WEM8" then 128
				                else if t = "WEM9" then 129
				                else if t = "WEM10" then 130
				                else if t = "WEM11" then 131
				                else if t = "WEM12" then 132
				                // WEE## Teams
				                else if t = "WEE1" then 141
				                else if t = "WEE2" then 142
				                else if t = "WEE3" then 143
				                else if t = "WEE4" then 144
				                else if t = "WEE5" then 145
				                else if t = "WEE6" then 146
				                else if t = "WEE7" then 147
				                else if t = "WEE8" then 148
				                else if t = "WEE9" then 149
				                else if t = "WEE10" then 150
				                else if t = "WEE11" then 151
				                else if t = "WEE12" then 152
				                else 999,
				        Int64.Type),
				    
				    // Add Hour Nights
				    #"Added Hour Nights" = Table.AddColumn(#"Added Team Sort", "Hour Nights", 
				        each [Hour], 
				        type text),
				    
				    // Add Hour Nights Sort
				    #"Added Hour Nights Sort" = Table.AddColumn(#"Added Hour Nights", "Hour Nights Sort", 
				        each 
