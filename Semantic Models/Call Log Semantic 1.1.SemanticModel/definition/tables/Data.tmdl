	measure 'AVG Speed' =
			
			VAR TotalSeconds = [Avg Speed to Answer]
			VAR Minutes = INT (TotalSeconds / 60)
			VAR Seconds = ROUND(MOD(Totalseconds,60),0)
			RETURN
			FORMAT (Minutes, "0") &":"& FORMAT(Seconds, "00")
		lineageTag: 76a846f2-2d4e-4d05-8f9e-bcf61d5c6232

	measure 'Longest Wait Time' =
			
			VAR TotalSeconds = [Longest Speed to Answer]
			VAR Minutes = INT (TotalSeconds / 60)
