	measure Pct_Under60 = ```
			
			VAR TotalCalls = COUNTROWS(Data)
			VAR CallsUnder60 = CALCULATE(COUNTROWS(Data), 'Data'[Wait Seconds] < 60)
			RETURN
			DIVIDE(CallsUnder60, TotalCalls)
			
			```
		lineageTag: ff497cb0-5651-4299-ae3c-75841f8cb1f8

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Donut Value' =
			
			VAR lbl = SELECTEDVALUE ( Slices[Label] )
			RETURN
			SWITCH (
			    TRUE(),
			    lbl = "Filled",     [Pct_Under60],
			    lbl = "Remaining",  1 - [Pct_Under60],
			    BLANK()
			)
		lineageTag: 4be085a3-c505-4289-931b-18f55c55bd0c

	measure 'Donut Color' =
			
			VAR lbl = SELECTEDVALUE ( Slices[Label] )
			RETURN
			IF (
			    lbl = "Remaining",
			    "#E5E5E5",                                 -- light gray
			    SWITCH (
			        TRUE(),
			        [Pct_Under60] >= 0.8, "#107C10",       -- green
			        [Pct_Under60] >= 0.7, "#FFB900",       -- yellow
			        "#E81123"                              -- red
			    )
			)
		lineageTag: 8096893e-0542-4005-87cb-6f8f9f8c87e8

	measure 'Under 60 Seconds' = SUM(talk)
		lineageTag: bff0b47f-5c09-4160-8c38-5f2e50da6a0e

	measure Calls_Under60 = ```
			
