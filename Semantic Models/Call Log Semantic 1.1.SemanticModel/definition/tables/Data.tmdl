	column 'Time of Day' =
			
			VAR dt = 'Data'[Contact Start Date Time]
			VAR h = HOUR(dt)
			VAR m = MINUTE(dt)
			VAR RoundedMin = FLOOR(m, 15)
			VAR h12 = IF(MOD(h, 12) = 0, 12, MOD(h, 12))
			VAR ampm = IF(h < 12, "a", "p")
			VAR minText = IF(RoundedMin = 0, ":00", ":" & FORMAT(RoundedMin, "00"))
			RETURN
			    h12 & minText & ampm
		lineageTag: 540d09d2-ae31-4fea-b487-b0146a2fe1cb
		summarizeBy: none
		sortByColumn: 'Time of Day Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	hierarchy 'Hour Hierarchy'
		lineageTag: 29292e15-38ec-474a-82ce-fcb7c44867bb

		level Hour
			lineageTag: fe3387b4-2fe8-4ea9-b90a-06560aac8324
			column: Hour

		level 'Time of Day'
			lineageTag: 86e87407-1e3f-4f4e-8e9b-b18a3d14ba11
			column: 'Time of Day'

	partition Data = m
		mode: import
		source = ```
				let
				    // Append all monthly queries
				    Source = Table.Combine({
				        #"12012025",
				        #"11012025",
				        #"10012025",
				        #"09012025",
				        #"06012025",
				        #"03012025"
				    }),
				    
				    // Do ALL type conversions upfront
				    #"Changed Type" = Table.TransformColumnTypes(Source,{
				        {"Contact Start Date Time", type datetime}, 
				        {"Contact End Date Time", type datetime}
				    }),
				    
				    // Remove old columns early
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{
				        "Call Result", "Date", "Day of Week", "Time", "Hour1", "Hour", "Minute", 
				        "Under 60", "Skilled", "Customer Name", "Program", "Reporting Date", 
				        "Reporting Day", "Service Line", "Speed of Answer", "Talk Time", "ACW Time", 
				        "Contact Duration", "Month", "New Skilled", "New New Skilled", "Team", 
				        "Minute Bucket", "Combo", "Adressable", "Weekday"
				    }),
				    
				    // Buffer lookup tables for performance
				    BufferedCustomer = Table.Buffer(Table.Distinct(Customer, {"Reference"})),
				    BufferedNurse = Table.Buffer(Table.Distinct(#"Nurse Reference", {"Log in Reference", "Client"})),
				    BufferedTeam = Table.Buffer(Table.Distinct(Team, {"Day of Week", "Hour", "Customer Name"})),
				    
				    // Add all calculated columns BEFORE merges
				    #"Added Date" = Table.AddColumn(#"Removed Columns", "Date", each Date.From([Contact Start Date Time]), type date),
				    
				    #"Added Day of Week" = Table.AddColumn(#"Added Date", "Day of Week", each 
				        try Date.ToText(Date.From([Pasted Date]), "ddd") otherwise null,
				    type text),
				    
				    #"Added Time" = Table.AddColumn(#"Added Day of Week", "Time", each Time.From([Contact Start Date Time]), type time),
				    
				    #"Added Hour1" = Table.AddColumn(#"Added Time", "Hour1", each Time.Hour([Contact Start Date Time]), Int64.Type),
				    
				    #"Added Hour" = Table.AddColumn(#"Added Hour1", "Hour", each 
				        let h = [Hour1]
				        in if h = 0 then "12 AM"
				           else if h = 12 then "12 PM"
				           else if h < 12 then Text.From(h) & " AM"
				           else Text.From(h - 12) & " PM",
				    type text),
				    
				    #"Added Minute" = Table.AddColumn(#"Added Hour", "Minute", each Time.Minute([Contact Start Date Time]), Int64.Type),
				    
				    #"Added Reporting Date" = Table.AddColumn(#"Added Minute", "Reporting Date", each 
				        if [Hour1] < 5 then Date.AddDays([Date], -1) else [Date],
				    type date),
				    
				    #"Added Month" = Table.AddColumn(#"Added Reporting Date", "Month", each Date.Month([Reporting Date]), Int64.Type),
				    
				    // Rename pasted columns
				    #"Renamed Pasted Columns" = Table.RenameColumns(#"Added Month",{
				        {"Talk Time Pasted", "Talk Time"}, 
				        {"ACW Time Pasted", "ACW Time"}, 
				        {"Contact Duration Pasted", "Contact Duration"}
				    }),
				    
				    // Add Call Result
				    #"Added Call Result" = Table.AddColumn(#"Renamed Pasted Columns", "Call Result", each 
				        let
				            skill = try [Contact Skill Name] otherwise "",
				            abandons = try [Abandons] otherwise null,
				            prequeue = try [Prequeue Abandons] otherwise null,
				            talkTime = try [Talk Time] otherwise null,
				            hasAbandons = if abandons = null then false else abandons > 0,
				            hasPrequeue = if prequeue = null then false else prequeue > 0,
				            hasTalkTime = if talkTime = null then false else try Text.Length(Text.From(talkTime)) > 0 otherwise false
				        in
				            if skill = "Manual Outbound" then "Outbound"
				            else if hasAbandons or hasPrequeue then "Abandoned"
				            else if hasTalkTime then "Answered"
				            else null,
				    type text),
				    
				    // Add Speed of Answer
				    #"Added Speed of Answer" = Table.AddColumn(#"Added Call Result", "Speed of Answer", each let
				    callResult = [Call Result],
				    speedPasted = try [Speed Of Answer Pasted] otherwise "",
				    durationPasted = try [Contact Duration] otherwise "",
				    durationValue = if callResult = "Answered" then try Duration.From(speedPasted) otherwise null
				                    else if callResult = "Abandoned" or callResult = "Outbound" then try Duration.From(durationPasted) otherwise null
				                    else null
				in
				    if durationValue = null then null
				    else #datetime(1899, 12, 31, 0, 0, 0) + durationValue),
				    
				    // Add Under 60
				    #"Added Under 60" = Table.AddColumn(#"Added Speed of Answer", "Under 60", each let
				    speed = try [Speed of Answer] otherwise null,
				    baseDateTime = #datetime(1899, 12, 31, 0, 0, 0),
				    oneMinuteDateTime = #datetime(1899, 12, 31, 0, 1, 0)
				in
				    if speed = null then null
				    else if speed < oneMinuteDateTime then 1
				    else 0),
				    
				    // NOW do the merges - all at once
				    #"Merged Customer" = Table.NestedJoin(#"Added Under 60", {"Contact Skill Name"}, BufferedCustomer, {"Reference"}, "Customer", JoinKind.LeftOuter),
				    #"Expanded Customer" = Table.ExpandTableColumn(#"Merged Customer", "Customer", {"Customer", "Program", "Service Line", "Skilled"}, {"Customer", "Program", "Service Line", "Skilled"}),
				    
				    #"Merged Nurse" = Table.NestedJoin(#"Expanded Customer", {"Contact Agent Name", "Customer"}, BufferedNurse, {"Log in Reference", "Client"}, "Nurse Reference", JoinKind.LeftOuter),
				    #"Expanded Nurse" = Table.ExpandTableColumn(#"Merged Nurse", "Nurse Reference", {"Skill Reference"}, {"New Skilled"}),
				    
				    // Add New New Skilled
				    #"Added New New Skilled" = Table.AddColumn(#"Expanded Nurse", "New New Skilled", each 
				        try (
				            if [Skilled] = false then 1
				            else if [Skilled] = "ELSE" then 2
				            else if [Skilled] = true and [New Skilled] = 1 then 1
				            else 3
				        ) otherwise 3,
				    Int64.Type),
				    
				    #"Merged Team" = Table.NestedJoin(#"Added New New Skilled", {"Day of Week", "Hour1", "Customer"}, Team, {"Day of Week", "Hour", "Customer Name"}, "Team", JoinKind.LeftOuter),
				    #"Expanded Team" = Table.ExpandTableColumn(#"Merged Team", "Team", {"Team"}, {"Team"}),
				    
				    // Add sorting columns
				    #"Added Team Sort" = Table.AddColumn(#"Expanded Team", "Team Sort Order", each 
				        let t = [Team]
				        in
				            // Standard Teams
				            if t = "Team 1" then 1
				            else if t = "Team 2" then 2
				            else if t = "Team 3" then 3
				            else if t = "Team 4" then 4
				            else if t = "Team 5" then 5
				            else if t = "Team 6" then 6
				            else if t = "Team 7" then 7
				            else if t = "Team 8" then 8
				            else if t = "Team 9" then 9
				            else if t = "Team 10" then 10
				            else if t = "Team 11" then 11
				            else if t = "Team 12" then 12
				            // NAL Weekend Teams
				            else if t = "NAL Weekend Morning" then 20
				            else if t = "NAL Weekend Day" then 21
				            else if t = "NAL Weekend Evening" then 22
				            else if t = "NAL Weekend Overnight" then 23
				            // WED## Teams
				            else if t = "WED1" then 101
				            else if t = "WED2" then 102
				            else if t = "WED3" then 103
				            else if t = "WED4" then 104
				            else if t = "WED5" then 105
				            else if t = "WED6" then 106
				            else if t = "WED7" then 107
				            else if t = "WED8" then 108
				            else if t = "WED9" then 109
				            else if t = "WED10" then 110
				            else if t = "WED11" then 111
				            else if t = "WED12" then 112
				            // WEM## Teams
				            else if t = "WEM1" then 121
				            else if t = "WEM2" then 122
				            else if t = "WEM3" then 123
				            else if t = "WEM4" then 124
				            else if t = "WEM5" then 125
				            else if t = "WEM6" then 126
				            else if t = "WEM7" then 127
				            else if t = "WEM8" then 128
				            else if t = "WEM9" then 129
				            else if t = "WEM10" then 130
				            else if t = "WEM11" then 131
				            else if t = "WEM12" then 132
				            // WEE## Teams
				            else if t = "WEE1" then 141
				            else if t = "WEE2" then 142
				            else if t = "WEE3" then 143
				            else if t = "WEE4" then 144
				            else if t = "WEE5" then 145
				            else if t = "WEE6" then 146
				            else if t = "WEE7" then 147
				            else if t = "WEE8" then 148
				            else if t = "WEE9" then 149
				            else if t = "WEE10" then 150
				            else if t = "WEE11" then 151
				            else if t = "WEE12" then 152
				            else 999,
				    Int64.Type),
				    
				    #"Added Hour Nights" = Table.AddColumn(#"Added Team Sort", "Hour Nights", each [Hour], type text),
				    
				    #"Added Hour Nights Sort" = Table.AddColumn(#"Added Hour Nights", "Hour Nights Sort", each 
				        let h = [Hour Nights]
				        in
				            if h = "11 PM" then 1
				            else if h = "12 AM" then 2
				            else if h = "1 AM" then 3
				            else if h = "2 AM" then 4
				            else if h = "3 AM" then 5
				            else if h = "4 AM" then 6
				            else if h = "5 AM" then 7
				            else if h = "6 AM" then 8
				            else if h = "7 AM" then 9
				            else 999,
				    Int64.Type),
				    #"Added Custom" = Table.AddColumn(#"Added Hour Nights Sort", "Reporting Day", each try Date.DayOfWeek([Reporting Date], Day.Sunday) + 1 otherwise null),
				    #"Renamed Columns" = Table.RenameColumns(#"Added Custom",{{"Customer", "Customer Name"}}),
				    #"Changed Type1" = Table.TransformColumnTypes(#"Renamed Columns",{{"New New Skilled", type text}})
				in
				    #"Changed Type1"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

