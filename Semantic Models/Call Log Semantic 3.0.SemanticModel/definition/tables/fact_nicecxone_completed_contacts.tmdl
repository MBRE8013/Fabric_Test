	column Hour =
			
			DATE(1899, 12, 31) + TIME(HOUR([contact_start_date]), 0, 0)
		formatString: General Date
		lineageTag: 1987a60e-646f-4633-b96b-57ae3712ddea
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 9205a9d2-a347-4978-bb8d-b5b3e231abb5
			defaultHierarchy: LocalDateTable_805fbb65-c8b7-4025-80b4-2746212ecf09.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column Team =
			
			VAR CustomerName = RELATED(dim_Customer[Customer])
			VAR FactHour = [Hour]
			VAR FactDayOfWeek = [Day of Week]
			RETURN
			    LOOKUPVALUE(
			        dim_Team[Team],
			        dim_Team[Customer Name], CustomerName,
			        dim_Team[Hour], FactHour,
			        dim_Team[Reporting Day of Week], FactDayOfWeek
			    )
		lineageTag: f490935a-d8e0-402d-88c7-4e5461311acb
		summarizeBy: none
		sortByColumn: 'Team Sort Order'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Day of Week' =
			
			FORMAT([contact_start_date], "ddd")
		lineageTag: a1510c25-e8e7-4184-ac51-34d94ad6931f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Hour Formatted' =
			
