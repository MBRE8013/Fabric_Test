		source = ```
				let
				    Source = Sql.Databases("xcw6jyrd7wyupgr6hyhdgeb62y-tkhwq332pddenadirvxir3oqke.datawarehouse.fabric.microsoft.com"),
				    IntellaTriageLakehouse = Source{[Name="IntellaTriageLakehouse"]}[Data],
				    dbo_fact_nicecxone_completed_contacts = IntellaTriageLakehouse{[Schema="dbo",Item="fact_nicecxone_completed_contacts"]}[Data],
				    #"Filtered Rows" = Table.SelectRows(dbo_fact_nicecxone_completed_contacts, each not Text.Contains([skill_name], "TEST") and not Text.Contains([skill_name], "Do Not Assign")),
				    
				    // Add Date
				    #"Added Date" = Table.AddColumn(#"Filtered Rows", "Date", 
				        each Date.From([contact_start_date]), 
				        type date),
				    
				    // Add Hour1
				    #"Added Hour1" = Table.AddColumn(#"Added Date", "Hour1", 
				        each Time.Hour([contact_start_date]), 
				        Int64.Type),
				    
				    // Add Reporting Date
				    #"Added Reporting Date" = Table.AddColumn(#"Added Hour1", "Reporting Date", 
				        each if [Hour1] < 5 then Date.AddDays([Date], -1) else [Date],
				        type date),
				    
				    // Add Call Result
				    #"Added Call Result" = Table.AddColumn(#"Added Reporting Date", "Call Result", 
				        each 
				            let
				                skill = try [skill_name] otherwise "",
				                abandonedFlag = try [abandoned] otherwise false,
				                abandonSeconds = try [abandon_seconds] otherwise 0,
				                agentSeconds = try [agent_seconds] otherwise 0,
				                hasAbandoned = (abandonedFlag = true) or (abandonSeconds > 0),
				                hasTalkTime = (agentSeconds > 0)
				            in
				                if skill = "Manual Outbound" then "Outbound"
				                else if hasAbandoned then "Abandoned"
				                else if hasTalkTime then "Answered"
				                else "Abandoned",  // No talk time = Abandoned
				        type text)
				in
