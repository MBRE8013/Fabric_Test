		summarizeBy: none
		sourceColumn: Call Result

		annotation SummarizationSetBy = Automatic

	column 'Team Sort Order' = ```
			
			VAR CustomerName = RELATED(dim_Customer[Customer])
			VAR FactHour = [Hour]
			VAR FactDayOfWeek = [Day of Week]
			VAR TeamValue = 
			    LOOKUPVALUE(
			        dim_Team[Team],
			        dim_Team[Customer Name], CustomerName,
			        dim_Team[Hour], FactHour,
			        dim_Team[Reporting Day of Week], FactDayOfWeek
			    )
			RETURN
			SWITCH(
			    TeamValue,
			    // Standard Teams
			    "Team 1", 1,
			    "Team 2", 2,
			    "Team 3", 3,
			    "Team 4", 4,
			    "Team 5", 5,
			    "Team 6", 6,
			    "Team 7", 7,
			    "Team 8", 8,
			    "Team 9", 9,
			    "Team 10", 10,
			    "Team 11", 11,
			    "Team 12", 12,
			    // NAL Weekend Teams
			    "NAL Weekend Morning", 20,
			    "NAL Weekend Day", 21,
			    "NAL Weekend Evening", 22,
			    "NAL Weekend Overnight", 23,
			    // WED## Teams
			    "WED1", 101,
			    "WED2", 102,
			    "WED3", 103,
			    "WED4", 104,
			    "WED5", 105,
			    "WED6", 106,
			    "WED7", 107,
			    "WED8", 108,
			    "WED9", 109,
			    "WED10", 110,
			    "WED11", 111,
			    "WED12", 112,
			    // WEM## Teams
			    "WEM1", 121,
			    "WEM2", 122,
			    "WEM3", 123,
			    "WEM4", 124,
			    "WEM5", 125,
			    "WEM6", 126,
			    "WEM7", 127,
			    "WEM8", 128,
			    "WEM9", 129,
			    "WEM10", 130,
