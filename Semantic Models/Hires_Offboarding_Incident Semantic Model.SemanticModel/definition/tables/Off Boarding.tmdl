	column 'Term Within 90?' =
			
			VAR DaysBetween = DATEDIFF([Start Date], [Term Effective], DAY)
			RETURN
			IF(
			    NOT ISBLANK([Term Effective]) && NOT ISBLANK([Start Date]),
			    IF(DaysBetween <= 90, "Yes", "No"),
			    BLANK()
			)
		lineageTag: 33462fa1-a702-4ee8-9aff-ba78353e5336
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Term Within 30?' =
			
			VAR DaysBetween = DATEDIFF([Start Date], [Term Effective], DAY)
			RETURN
			IF(
			    NOT ISBLANK([Term Effective]) && NOT ISBLANK([Start Date]),
			    IF(DaysBetween <= 30, "Yes", "No"),
			    BLANK()
			)
		lineageTag: 5fb6ed76-8500-4b82-ada6-dfd01b1ee501
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Days Employed' =
			
			DATEDIFF([Start Date], [Term Effective], DAY)
		formatString: 0
		lineageTag: be0d5e6e-bacb-402e-b696-c9c821ea8ee7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Week Range' =
			
			VAR WeekStart = [Term Effective] - WEEKDAY([Term Effective], 2) + 1
			VAR WeekEnd = WeekStart + 4
			RETURN
			FORMAT(WeekStart, "M/D") & " - " & FORMAT(WeekEnd, "M/D/YY")
		lineageTag: 71f04526-f0e2-48dd-a8ef-f305ebf3232b
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Name = 'Off Boarding'[Employee Last Name]&", "& 'Off Boarding'[Employee First Name]
		lineageTag: d9823a3f-1315-454f-9087-bf620fb8e170
