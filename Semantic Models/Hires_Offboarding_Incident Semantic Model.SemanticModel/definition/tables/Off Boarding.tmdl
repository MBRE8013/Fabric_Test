table 'Off Boarding'
	lineageTag: 8cbd9719-6f5c-4746-ae80-85bb46ff36b2

	measure 'Date Range (Shown)' =
			
			VAR MinD =
			    CALCULATE ( MIN ( 'Off Boarding'[Term Effective] ), ALLSELECTED ( 'Off Boarding' ) )
			VAR MaxD =
			    CALCULATE ( MAX ( 'Off Boarding'[Term Effective]  ), ALLSELECTED ( 'Off Boarding' ) )
			RETURN
			IF (
			    ISBLANK ( MinD ) || ISBLANK ( MaxD ),
			    "No data",
			    IF (
			        MinD = MaxD,
			        FORMAT ( MinD, "[$-en-US]mm/dd/yy" ),
			        FORMAT ( MinD, "[$-en-US]mm/dd/yy" ) & " – " &
			        FORMAT ( MaxD, "[$-en-US]mm/dd/yy" )
			    )
			)
		lineageTag: 843aa5ed-3d47-430f-bd27-cf76e8fbe4eb

