	column State
		dataType: string
		lineageTag: 519b0a66-3696-4099-a8e6-5c96eb2df211
		summarizeBy: none
		sourceColumn: State

		annotation SummarizationSetBy = Automatic

	column 'Term Category' =
			
			VAR DaysBetween = DATEDIFF([Start Date], [Term Effective], DAY)
			RETURN
			IF(
			    NOT ISBLANK([Term Effective]) && NOT ISBLANK([Start Date]),
			    SWITCH(
			        TRUE(),
			        DaysBetween <= 30, "30-day",
			        DaysBetween <= 90, "90-day",
			        "> 90"
			    ),
			    BLANK()
			)
		lineageTag: 4b2b7a98-bbbb-4f46-b5aa-3c0485832bb8
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition 'Off Boarding' = m
		mode: import
		source = ```
				let
				    // Source data
				    Source = SharePoint.Tables("https://intellatriage.sharepoint.com/sites/PeoplePrograms", [Implementation="2.0", ViewMode="Default"]),
				    #"67bed17d-d32f-45a6-a3e7-a60f49454933" = Source{[Id="67bed17d-d32f-45a6-a3e7-a60f49454933"]}[Items],
				    
				    // Prepare New Hire Tracking - deduplicate to prevent cartesian products
				    NewHirePrep = 
				        let
				            // Check if FirstNameStartDateConcat exists, if not create it
				            HasConcatColumn = Table.HasColumns(#"New Hire Tracking", "FirstNameStartDateConcat"),
				            AddConcatIfNeeded = if HasConcatColumn then #"New Hire Tracking" 
				                else Table.AddColumn(#"New Hire Tracking", "FirstNameStartDateConcat", each 
				                    if [first name] <> null and [start date] <> null 
				                    then [first name] & DateTime.ToText([start date],"MM/dd/yyyy") 
				                    else null),
				            
				            // Add name key for matching
				            AddNameKey = Table.AddColumn(AddConcatIfNeeded, "NameKey", each 
				                if [first name] <> null and [last name] <> null 
				                then Text.Lower(Text.Trim([first name])) & "|" & Text.Lower(Text.Trim([last name])) 
				                else null),
				            
				            // Remove complete duplicates first
				            RemoveDupes = Table.Distinct(AddNameKey),
				            
				            // Filter to only rows with non-null, non-empty state values
				            FilterValidState = Table.SelectRows(RemoveDupes, each [state] <> null and [state] <> ""),
				            
				            // Deduplicate by email - keep first record per email
				            DedupeByEmail = Table.Distinct(FilterValidState, {"email"}),
				            
				            // Deduplicate by FirstNameStartDateConcat - keep first record per concat key
				            DedupeByConcat = Table.Distinct(DedupeByEmail, {"FirstNameStartDateConcat"}),
				            
				            // Deduplicate by NameKey - keep first record per name
				            DedupeByName = Table.Distinct(DedupeByConcat, {"NameKey"})
				        in
				            DedupeByName,
				    
				    // Add matching keys to SharePoint data
				    AddConcatKey = Table.AddColumn(#"67bed17d-d32f-45a6-a3e7-a60f49454933", "SP_FirstNameStartDateConcat", 
				        each [Employee First Name] & DateTime.ToText([Start Date],"MM/dd/yyyy")),
				    AddNameKey = Table.AddColumn(AddConcatKey, "SP_NameKey", 
				        each Text.Lower(Text.Trim([Employee First Name])) & "|" & Text.Lower(Text.Trim([Employee Last Name]))),
				    
				    // Join by email (highest priority)
				    MergedByEmail = Table.NestedJoin(AddNameKey, {"Personal Email Address"}, NewHirePrep, {"email"}, "EmailMatch", JoinKind.LeftOuter),
				    ExpandEmail = Table.ExpandTableColumn(MergedByEmail, "EmailMatch", {"state"}, {"State_Email"}),
				    
				    // Join by FirstNameStartDateConcat (second priority)
				    MergedByConcat = Table.NestedJoin(ExpandEmail, {"SP_FirstNameStartDateConcat"}, NewHirePrep, {"FirstNameStartDateConcat"}, "ConcatMatch", JoinKind.LeftOuter),
				    ExpandConcat = Table.ExpandTableColumn(MergedByConcat, "ConcatMatch", {"state"}, {"State_Concat"}),
				    
				    // Join by Name (lowest priority)
				    MergedByName = Table.NestedJoin(ExpandConcat, {"SP_NameKey"}, NewHirePrep, {"NameKey"}, "NameMatch", JoinKind.LeftOuter),
				    ExpandName = Table.ExpandTableColumn(MergedByName, "NameMatch", {"state"}, {"State_Name"}),
				    
				    // Coalesce state values with priority: Email > Concat > Name
				    AddFinalState = Table.AddColumn(ExpandName, "State", each 
				        if [State_Email] <> null and [State_Email] <> "" then [State_Email]
				        else if [State_Concat] <> null and [State_Concat] <> "" then [State_Concat]
				        else if [State_Name] <> null and [State_Name] <> "" then [State_Name]
				        else null),
				    
				    // Clean up working columns
				    RemovedColumns = Table.RemoveColumns(AddFinalState, {
				        "SP_FirstNameStartDateConcat", "SP_NameKey", 
				        "State_Email", "State_Concat", "State_Name"
				    }),
				    
				    // Final deduplication by ID (should be unnecessary now but acts as safety net)
				    RemovedDuplicates = Table.Distinct(RemovedColumns, {"ID"})
				in
				    RemovedDuplicates
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

