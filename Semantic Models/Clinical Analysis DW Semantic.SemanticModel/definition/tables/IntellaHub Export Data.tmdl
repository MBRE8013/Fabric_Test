	column 'Hour Label' = ```
			
			VAR HourNum = 'IntellaHub Export Data'[hour]
			VAR Period = IF(HourNum < 12, "AM", "PM")
			VAR DisplayHour = 
			    SWITCH(
			        TRUE(),
			        HourNum = 0, 12,
			        HourNum <= 12, HourNum,
			        HourNum - 12
			    )
			RETURN DisplayHour & " " & Period
			```
		lineageTag: 26773935-ee82-4b67-8336-a1f09d3e20ff
		summarizeBy: none
		sortByColumn: 'Hour Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Hour Sort' =
			
			IF(
			    'IntellaHub Export Data'[hour] >= 5,
			    'IntellaHub Export Data'[hour] - 5,
			    'IntellaHub Export Data'[hour] + 19
			)
		lineageTag: 0395e08c-ee19-40ae-b6ee-17148ec40248
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Abv Day of Week' = FORMAT('IntellaHub Export Data'[Date], "ddd")
		lineageTag: e2e37ca1-fcb8-49e9-a7ec-b6eefa2f50b8
		summarizeBy: none
		sortByColumn: 'Day of Week Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Day of Week Sort' = WEEKDAY('IntellaHub Export Data'[Date], 2)
		formatString: 0
		lineageTag: 84eb1c82-55d9-4867-b7cc-df6f50dbd79a
